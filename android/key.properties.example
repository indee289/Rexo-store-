# ─────────────────────────────────────────────────────────────────────────────
# Campster — Android release signing (EXAMPLE / TEMPLATE)
#
# Copy this file to `android/key.properties` and fill in real values.
# DO NOT commit the real key.properties or the keystore — both are git-ignored.
#
# `storeFile` may be absolute or relative to the `android/app/` module.
# ─────────────────────────────────────────────────────────────────────────────

storeFile=/absolute/path/to/rexo-release.jks
storePassword=CHANGE_ME_store_password
keyAlias=rexo
keyPassword=CHANGE_ME_key_password
