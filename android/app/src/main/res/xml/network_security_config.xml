<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow cleartext traffic to localhost for development -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
  </domain-config>

  <!-- Allow HTTPS traffic to Supabase (extract domain from URL) -->
  <!-- Example: if VITE_SUPABASE_URL is https://xyz.supabase.co, add that domain -->
  <domain-config>
    <domain includeSubdomains="true">supabase.co</domain>
  </domain-config>

  <!-- Trust system certificates by default -->
  <trust-anchors>
    <certificates src="system" />
  </trust-anchors>
</network-security-config>
