<?xml version="1.0" encoding="utf-8"?>
<!--
  Disables cloud backup and device-to-device transfer of app data.
  This prevents the Supabase auth session (stored in SharedPreferences)
  from being restored after an uninstall/reinstall, which was causing
  automatic login as a previous user (including admin).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
