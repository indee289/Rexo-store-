# SUPABASE EDGE FUNCTIONS SECRETS (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)

# Supabase Project Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare R2 Storage Credentials (Server-Side Only)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Gemini AI API Key (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key

# Firebase Cloud Messaging Server Credentials (Optional - Server-Side Only)
FCM_PROJECT_ID=your_fcm_project_id
FCM_CLIENT_EMAIL=your_fcm_client_email
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Payment Gateway Secrets (Server-Side Only)
PAYMENT_SECRET_KEY=your_payment_gateway_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_key
