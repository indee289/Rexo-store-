    {"name": "Initialize Flutter License", "command": "flutter doctor --version"}
  ],
  "templateName": "custom",
  "projectDependencies": [
    {"name": "Install Flutter Dependencies", "command": "flutter pub get"}
  ],
  "codeChecks": [
    {"name": "Run Flutter Lint", "command": "flutter lint"}
